<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- P2-B 唯一的网络权限：真实 Provider 适配层需要访问用户自行配置的模型服务。
         不添加任何其他权限（无无障碍、存储、通知、悬浮窗等）。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AgentApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AiUseAgent">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.attachment.camera"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/attachment_camera_paths" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
